#!/usr/bin/env bash
# Signal only the recorder started by Afterglow; never all capture processes.
set -euo pipefail
pid_file="${XDG_RUNTIME_DIR:?Run this inside your desktop session}/afterglow-recorder.pid"
if [[ ! -r "$pid_file" ]]; then
  echo 'Afterglow replay is not running.' >&2
  exit 1
fi
read -r pid < "$pid_file" || [[ -n "${pid:-}" ]]
[[ "$pid" =~ ^[1-9][0-9]*$ ]] || exit 1
[[ "$(stat -c %u "/proc/$pid")" == "$UID" ]] || exit 1
IFS= read -r -d '' executable < "/proc/$pid/cmdline" || true
[[ "${executable##*/}" == gpu-screen-recorder ]] || exit 1
kill -USR1 "$pid"
