# Maintainer: AUR maintainer account pending
# Native releases are public; an AUR entry has not been submitted.
pkgname=afterglow-bin
pkgver=0.1.8
pkgrel=1
url='https://github.com/AeoryUX/Afterglow'
pkgdesc='Instant replay and local gameplay clips for Linux'
arch=('x86_64')
license=('GPL-3.0-only')
depends=('glibc>=2.39' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'ffmpeg' 'pipewire-audio' 'gst-libav' 'gst-plugins-good' 'xdg-utils' 'desktop-file-utils' 'gpu-screen-recorder' 'nvidia-utils')
provides=('afterglow')
conflicts=('afterglow')
options=('!strip' '!debug')
source=("afterglow-${pkgver}-linux-x86_64.tar.gz::https://raw.githubusercontent.com/AeoryUX/Afterglow/v${pkgver}-packages/releases/v${pkgver}/afterglow-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('9325d9eb4e0ed6a4ea87e16c9ec1aff0561ea19dc675e1a361ceffc193a67b0c')

package() {
    local release="$srcdir/afterglow-${pkgver}-linux-x86_64"
    install -Dm755 "$release/afterglow" "$pkgdir/usr/bin/afterglow"
    install -Dm755 "$release/afterglow-save" "$pkgdir/usr/bin/afterglow-save"
    install -Dm644 "$release/icon.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/dev.afterglow.desktop.png"
    install -Dm644 "$release/SECURITY.md" "$pkgdir/usr/share/doc/afterglow/SECURITY.md"
    install -Dm644 "$release/README.md" "$pkgdir/usr/share/doc/afterglow/README.md"
    install -Dm644 "$release/THIRD_PARTY_NOTICES.txt" "$pkgdir/usr/share/licenses/afterglow-bin/THIRD_PARTY_NOTICES.txt"
    install -Dm644 "$release/COPYING" "$pkgdir/usr/share/licenses/afterglow-bin/COPYING"
    install -Dm644 "$release/LICENSE.md" "$pkgdir/usr/share/licenses/afterglow-bin/LICENSE.md"
    install -dm755 "$pkgdir/usr/share/applications"
    install -Dm644 "$release/afterglow.desktop" "$pkgdir/usr/share/applications/dev.afterglow.desktop.desktop"
    desktop-file-validate "$pkgdir/usr/share/applications/dev.afterglow.desktop.desktop"
}
