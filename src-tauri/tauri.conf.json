{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afterglow",
  "version": "0.1.1",
  "identifier": "dev.afterglow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Afterglow",
        "width": 1240,
        "height": 850,
        "minWidth": 850,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "targets": [
      "appimage"
    ],
    "shortDescription": "NVIDIA-first instant replay for Linux",
    "category": "Video",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
